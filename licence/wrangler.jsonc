{
  // Back Moon Devs licence service — the only online part of the offline Vertex ERP.
  // Secrets (never in this file): LICENCE_SIGNING_KEY, ADMIN_KEY
  //   npx wrangler secret put LICENCE_SIGNING_KEY --config licence/wrangler.jsonc
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vertex-licence",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "LICENCES", "id": "f23d3a0ee78c4daab1dd93daeda51cce" }],
  "observability": { "enabled": true }
}
