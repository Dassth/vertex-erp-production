{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "ignorePatterns": [
    "dist/**",
    "playwright-report/**",
    "test-results/**",
    "e2e/.playwright-profile/**",
    "dist-server/**",
    ".vertex-data/**",
    "backups/**",
    "dist-app-server/**",
    "create-test-export.js"
  ]
}
