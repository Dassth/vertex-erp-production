{
  "name": "vertex-software",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "demo:open": "node e2e/open-demo.mjs",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "server": "node dist-server/main.js serve",
    "server:dev": "node dist-server/main.js serve --dev",
    "server:start": "node dist-server/main.js serve",
    "server:backup": "node dist-server/main.js backup",
    "server:restore": "node dist-server/main.js restore",
    "server:import": "node dist-server/main.js import-browser",
    "build:server-app": "tsc -b && vite build --mode server --outDir dist-app-server",
    "cf:build": "npm run build:server-app",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build:server-app && wrangler deploy",
    "build:windows": "node installer/build.mjs",
    "licence:deploy": "wrangler deploy --config licence/wrangler.jsonc"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "adm-zip": "^0.6.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.34.0",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "17.10.0-beta.17",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.13.3",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "harfbuzzjs": "^1.6.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.133.0"
  }
}
